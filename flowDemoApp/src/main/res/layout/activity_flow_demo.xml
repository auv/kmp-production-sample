<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/titleCold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_cold"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonCold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_start_cold" />

        <TextView
            android:id="@+id/coldOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#1A237E" />

        <View
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/titleHot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title_hot"
            android:textStyle="bold" />

        <Button
            android:id="@+id/buttonState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_increment_state" />

        <Button
            android:id="@+id/buttonShared"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_emit_event" />

        <Button
            android:id="@+id/buttonChannel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/button_send_channel" />

        <TextView
            android:id="@+id/hotOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#004D40" />

        <Button
            android:id="@+id/buttonClear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/button_clear" />
    </LinearLayout>
</ScrollView>
